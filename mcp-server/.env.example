# Credenciales del servidor MCP. Copiar a .env (chmod 600) y completar.
#   cp .env.example .env && chmod 600 .env

# ── CouchDB ──────────────────────────────────────────────────────────────
# Usar el usuario NO-ADMIN (ver docs/03-seguridad.md). El MCP es un consumidor
# del vault, no un administrador de la base.
COUCHDB_URL=http://host.docker.internal:5984
COUCHDB_USER=livesync
COUCHDB_PASSWORD=<password-del-usuario-no-admin>
COUCHDB_DATABASE=obsidian
VAULT_NAME=MyVault

# ── Cifrado E2E ──────────────────────────────────────────────────────────
# Misma passphrase que el plugin Self-hosted LiveSync en cada dispositivo.
# Sin esto el servidor no puede descifrar las notas.
COUCHDB_PASSPHRASE=<passphrase-e2e>

# ── Auth del servidor MCP ────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
MCP_AUTH_TOKEN=<generar-con-openssl-rand>

DATA_DIR=/data
