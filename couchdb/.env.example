# Copiar a .env (chmod 600) y completar. NUNCA commitear el .env.
#   cp .env.example .env && chmod 600 .env

COUCHDB_USER=admin
# Password fuerte, sin caracteres especiales problemáticos para URLs/DSN
# (si usás $, #, @ o %, hay que URL-encodearla en las cadenas de conexión).
COUCHDB_PASSWORD=<cambiar-esta-password>
